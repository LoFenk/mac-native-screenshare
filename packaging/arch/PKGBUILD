export SOURCE_DATE_EPOCH=1789402952

prepare() {
  patch --directory="$srcdir/wayvnc" --strip=1 --input="$srcdir/wayvnc-private-rpath.patch"
  /usr/bin/python3 - "$srcdir" <<'CHECK'
import json
from pathlib import Path
import sys
root = Path(sys.argv[1])
lock = json.loads((root / 'integration/dependencies.json').read_text())
spec = json.loads((root / 'sources.json').read_text())
for item in spec['sources']:
    if item['name'] in lock['repositories']:
        assert item['commit'] == lock['repositories'][item['name']]['commit']
assert (root / 'integration/VERSION').read_text().strip() == spec['version']
CHECK
}

build() {
  # Exported sources have no .git directory. Ignore unrelated parent repositories.
  export GIT_CEILING_DIRECTORIES="$srcdir"
  export PYTHONDONTWRITEBYTECODE=1
  meson setup "$srcdir/build-neatvnc" "$srcdir/neatvnc" \
    --prefix=/usr/lib/mac-native-screenshare --libdir=lib --bindir=bin \
    --buildtype=debugoptimized --wrap-mode=nofallback \
    -Dtests=true -Dexamples=false -Djpeg=enabled -Dh264=disabled -Dgbm=disabled \
    -Dnettle=enabled -Dtls=enabled
  meson compile -C "$srcdir/build-neatvnc" -j2
  PKG_CONFIG_PATH="$srcdir/build-neatvnc/meson-uninstalled" \
    meson setup "$srcdir/build-wayvnc" "$srcdir/wayvnc" \
      --prefix=/usr/lib/mac-native-screenshare --libdir=lib --bindir=bin \
      --buildtype=debugoptimized --wrap-mode=nofallback \
      -Dtests=true -Dman-pages=disabled -Dscreencopy-dmabuf=disabled -Dpam=disabled
  meson compile -C "$srcdir/build-wayvnc" -j2
}

check() {
  export PYTHONDONTWRITEBYTECODE=1
  meson test -C "$srcdir/build-neatvnc" --print-errorlogs
  LD_LIBRARY_PATH="$srcdir/build-neatvnc" \
    meson test -C "$srcdir/build-wayvnc" --print-errorlogs
  /usr/bin/python3 "$srcdir/integration/test.py"
  /usr/bin/python3 "$srcdir/integration/test-lifecycle.py"
  /usr/bin/python3 "$srcdir/integration/test-package-lifecycle.py"
  lua "$srcdir/integration/test-mac-shortcuts.lua" "$srcdir/integration/mac-shortcuts.lua"
  lua "$srcdir/integration/test-hyprland-hook.lua" "$srcdir/integration/hyprland-hook.lua"
  mkdir -p "$srcdir/test-runtime"
  ln -sfn "$srcdir/build-wayvnc" "$srcdir/test-runtime/bin"
  ln -sfn "$srcdir/build-neatvnc" "$srcdir/test-runtime/lib"
  /usr/bin/python3 "$srcdir/integration/test-supervisor.py" --runtime "$srcdir/test-runtime"
  bash -n "$srcdir/integration/run.sh" "$srcdir/integration/mac-shortcuts.sh"
}

package() {
  # Meson installation removes build RPATHs and applies the private install RPATH.
  DESTDIR="$pkgdir" meson install -C "$srcdir/build-neatvnc" --no-rebuild --tags runtime
  DESTDIR="$pkgdir" meson install -C "$srcdir/build-wayvnc" --no-rebuild --tags runtime
  local _runtime="$pkgdir/usr/lib/$pkgname"
  local _docs="$pkgdir/usr/share/doc/$pkgname"
  local _licenses="$pkgdir/usr/share/licenses/$pkgname"
  for _file in probe.py mac-shortcuts.lua hyprland-hook.lua VERSION display-guide.txt \
      mns_common.py mns_cli.py mns_session.py mns_desktop.py mns_relay.py mns_discovery.py \
      package-lifecycle.py; do
    install -Dm644 "$srcdir/integration/$_file" "$_runtime/$_file"
  done
  install -Dm755 "$srcdir/integration/mac-native-screenshare" "$pkgdir/usr/bin/mac-native-screenshare"
  install -Dm644 "$srcdir/integration/mac-native-screenshare.service" "$pkgdir/usr/lib/systemd/user/mac-native-screenshare.service"
  for _file in mac-native-screenshare-upgrade.hook mac-native-screenshare-remove.hook; do
    install -Dm644 "$srcdir/integration/$_file" "$pkgdir/usr/share/libalpm/hooks/$_file"
  done
  install -Dm644 "$srcdir/README-PACKAGE.md" "$_docs/README.md"
  install -Dm644 "$srcdir/integration/docs/RELEASE_SCOPE.md" "$_docs/RELEASE_SCOPE.md"
  install -Dm644 "$srcdir/integration/docs/USAGE.md" "$_docs/USAGE.md"
  install -Dm644 "$srcdir/integration/ACKNOWLEDGEMENTS.md" "$_docs/ACKNOWLEDGEMENTS.md"
  install -Dm644 "$srcdir/sources.json" "$_docs/sources.json"
  install -Dm644 "$srcdir/integration/LICENSE" "$_licenses/LICENSE"
  install -Dm644 "$srcdir/neatvnc/COPYING" "$_licenses/neatvnc-COPYING"
  install -Dm644 "$srcdir/wayvnc/COPYING" "$_licenses/wayvnc-COPYING"
  install -Dm644 "$srcdir/THIRD-PARTY-NOTICES" "$_licenses/THIRD-PARTY-NOTICES"
  /usr/bin/python3 "$srcdir/verify-package.py" --root "$pkgdir"
}
